 "poems": [
  {
   "seq": "1",
   "text": "くらはしの山のかひより春霞年をつみてや立わたるらん",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "我宿の梅か枝になく鶯は風のたよりに香をやとめこし",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "むらさきに匂ふ藤浪打はへて松にちとせの色は見えけり",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "花たにもちらて別るゝ物ならはけふをわりなく惜まましやは",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "人にたにしらせてしかな隱れぬのみこもりにのみ戀や渡らん",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "あふ事の絕てしなくは中〓〓に人をも身をも恨さらまし",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "靑柳の糸はかけさへあやなれや氷もとけて今はむすはぬ",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "心こそ花にをくれてとまるらめ駒さへあやな過かてにする",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "初花をみてこそしのへ白露の置て殘せるなてしこの花",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "ほのかにもかげみてしかは女郞花野へにまされる色は有やと",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "秋霧は月のこゝろも心みに入山のはを立かくさなん",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "もみち葉のなかるゝ底を尋てそ山のふもとに我は來にける",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "萬代のはしめとけふを祈置て今行末は神そかそへん",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "音羽川身をはたきりてなかるとも君か宿にはまさりしもせし",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "別るともまた逢坂の關路にそしるもしらぬもまとはさりけり",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "行かへる物としる〓〓あやしくも別と聞はをしまるゝかな",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "もろともにをるとはなしに打とけてみえやしぬらん朝顔の花",
   "kana": "",
   "speaker": "朝忠卿集",
   "page": 94,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "古はおもひ出きや渡り河わたるてふなはなかれすや君",
   "kana": "",
   "speaker": "",
   "page": 94,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "なかれての名に社有けれ渡り河あふせありやと賴けるかな",
   "kana": "",
   "speaker": "",
   "page": 94,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "ぬれはつる水の下にもいかなれはこひといふ魚の絕す住らん",
   "kana": "",
   "speaker": "",
   "page": 94,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "池水のいひ出る事のかたけれはみこもりなから年そへにける",
   "kana": "",
   "speaker": "",
   "page": 94,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "人の世の花をはてにしせましかはけふかあすかと思はさらまし",
   "kana": "",
   "speaker": "",
   "page": 94,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "心にもまかせさりける命かとたのめもおかし常ならぬよに",
   "kana": "",
   "speaker": "",
   "page": 94,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "いたつらに立歸こし白浪のなみたにそてのひる時もなし",
   "kana": "",
   "speaker": "",
   "page": 94,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "何にかは袖のぬるらん白浪のなこりありともみえぬけしきを",
   "kana": "",
   "speaker": "",
   "page": 94,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "故里のならのみかとのはしめよりなれにけりともみゆる衣哉",
   "kana": "",
   "speaker": "",
   "page": 94,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "ふりぬとて思ひもすてしから衣よそへてあやな恨もそする",
   "kana": "",
   "speaker": "",
   "page": 94,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "白浪の立出るはまの演干鳥あとやは歸るしるへ成らん",
   "kana": "",
   "speaker": "",
   "page": 94,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "よのほとは今や〓〓と慰めつさめての後そわさとなかるゝ",
   "kana": "",
   "speaker": "",
   "page": 94,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "雲間にはいとゝ詠めそまさりける天の岩戶のひまやみゆると",
   "kana": "",
   "speaker": "",
   "page": 94,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "露はかり思ひおくへき心あらは消ぬさきにそ人は問まし",
   "kana": "",
   "speaker": "とはで程へていひ",
   "page": 94,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "思ひ出ておとつれしける山ひこの〔下關〕",
   "kana": "",
   "speaker": "",
   "page": 94,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "程へつる我玉しゐはいかにしてはかなき空にもてはなるらん",
   "kana": "",
   "speaker": "",
   "page": 94,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "七夕のあまのとわたるけふさへや遠かた人のつれなかるらん",
   "kana": "",
   "speaker": "",
   "page": 94,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "よそにわか人と〓〓を聞しかはあはれとも聞あなうとも聞",
   "kana": "",
   "speaker": "",
   "page": 94,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "知人はみよしもあらし思なる心のうちのこゝろならては",
   "kana": "",
   "speaker": "",
   "page": 94,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "道しらぬ物ならなくに足引の山ふみまとふ人も有けり",
   "kana": "",
   "speaker": "",
   "page": 94,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "しらかしの雪も絕にしあし引の山路を誰かふみまよふらん",
   "kana": "",
   "speaker": "",
   "page": 94,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "うすけれとうすくもあらす山吹のやへの色にし思そむれは",
   "kana": "",
   "speaker": "",
   "page": 94,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "かさぬれとうすき心のやへなれはそむてふ色の數は物かは",
   "kana": "",
   "speaker": "",
   "page": 94,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "しもつけやしはふきの杜の白露のかゝる折にや色かはるらむ",
   "kana": "",
   "speaker": "",
   "page": 94,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "ことしおひの竹の一よのへたつれは覺束なくも成まさる哉",
   "kana": "",
   "speaker": "朝忠卿集",
   "page": 94,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "幾世しもあらじ物ゆへわか竹のおひそはりける春さへそうき",
   "kana": "",
   "speaker": "",
   "page": 94,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "あふ事を松にかゝれる白露は久しきほとに消そしぬへき",
   "kana": "",
   "speaker": "",
   "page": 94,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "よと河の汀におふる若草の根をし絕ねはそこもしりなん",
   "kana": "",
   "speaker": "",
   "page": 94,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "山城のうりのつらくはみゆれともおもふ心のなとさはらめや",
   "kana": "",
   "speaker": "",
   "page": 94,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "47",
   "text": "もろともに君とほさなんぬれ衣はかなき名をは我のみやたつ",
   "kana": "",
   "speaker": "",
   "page": 94,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "48",
   "text": "望月のこま引わたる秋の夜は光あまねきものにそ有ける",
   "kana": "",
   "speaker": "",
   "page": 94,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "49",
   "text": "時しもあれ秋のさかりにつらけれは思はめ山に入ぬへきかな",
   "kana": "",
   "speaker": "",
   "page": 94,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "50",
   "text": "富士のれを音にそ聞し今はわか思にもゆる煙なりけり",
   "kana": "",
   "speaker": "",
   "page": 94,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "51",
   "text": "しるしなき思と聞は富士のれもそことはかりの煙成らん",
   "kana": "",
   "speaker": "",
   "page": 94,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "52",
   "text": "別ちを惜む心そ櫻花あふ坂まてはちらすもあらなん",
   "kana": "",
   "speaker": "",
   "page": 94,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "53",
   "text": "夢かとそわびては思たまさかをとふ人ありや又やさめぬる",
   "kana": "",
   "speaker": "",
   "page": 94,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "54",
   "text": "あはいとも思そわかぬうは玉のおなし夢ちにまとふ身なれは",
   "kana": "",
   "speaker": "海人手子良集",
   "page": 94,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "55",
   "text": "天の戶をあくるまをたにゆるされてまたきにのりて歸ける哉",
   "kana": "",
   "speaker": "",
   "page": 94,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "56",
   "text": "我妹子かねやのつまなる菖蒲草ねも顯はれて今朝はみゆらん",
   "kana": "",
   "speaker": "",
   "page": 94,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "57",
   "text": "あふ〓とのみやつかへにとわひつるを今朝の袂そ露けかりける",
   "kana": "",
   "speaker": "",
   "page": 94,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "58",
   "text": "人しれすうちはらひつる朝露にあやしく君もぬれにける哉",
   "kana": "",
   "speaker": "",
   "page": 94,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "59",
   "text": "いつとなくぬるゝ袂は古を忍ふる雨にぬれにけるかな",
   "kana": "",
   "speaker": "",
   "page": 94,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "60",
   "text": "人しれぬ野の下草となれる身も雨におとらぬ露そ置ける",
   "kana": "",
   "speaker": "",
   "page": 94,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  }
 ],
